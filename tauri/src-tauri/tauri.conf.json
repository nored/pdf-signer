{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Signer",
  "version": "0.1.0",
  "identifier": "com.schwarz.pdfsigner",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PDF Signer",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Click-to-place digital PDF signer.",
    "longDescription": "Cryptographically sign PDFs from a self-signed X.509 identity. Verify existing signatures. Runs entirely on your machine."
  }
}
