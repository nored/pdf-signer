{
  "name": "pdf-signer-desktop",
  "productName": "PDF Signer",
  "version": "0.1.0",
  "description": "Click-to-place digital PDF signer.",
  "main": "main.js",
  "author": "schwarz553@googlemail.com",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux --mac",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "pdfjs-dist": "3.11.174",
    "pdf-lib": "1.17.1",
    "node-forge": "1.3.1"
  },
  "build": {
    "appId": "com.schwarz.pdfsigner",
    "productName": "PDF Signer",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "node_modules/pdfjs-dist/build/pdf.min.js",
      "node_modules/pdfjs-dist/build/pdf.worker.min.js",
      "node_modules/pdf-lib/dist/pdf-lib.min.js",
      "node_modules/node-forge/dist/forge.min.js"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity"
    }
  }
}
